# OneClip reads only these optional settings. None of them is a secret:
# One keeps your credentials in its own store (`one init`, `one add typesafe`).

# Where projects, media, renders and the SQLite database live (default: ./.oneclip)
ONECLIP_DATA_DIR=

# Where finished 1080p clips are saved, one folder per video (default: ./clips, made automatically; a relative path starts from the OneClip folder)
ONECLIP_CLIPS_DIR=

# Python interpreter that has faster-whisper installed (default: python3, or python on Windows)
ONECLIP_PYTHON=

# Path to the One CLI entry if `one` isn't on PATH (a cli.js or an executable)
ONE_BIN=

# Pick a TypeSafe connection when you have more than one in One (the key, not a secret token)
ONE_TYPESAFE_KEY=

# Jev model alias (default: jev-latest; see `one actions execute typesafe <list-models-action> ...`)
ONECLIP_JEV_MODEL=

# Parallel Jev requests (default: 3)
ONECLIP_JEV_CONCURRENCY=

# Pick an OpenRouter connection when you have more than one in One (the key, not a secret token)
ONE_OPENROUTER_KEY=

# OpenRouter models for edit plans, comma-separated, tried in order, up to 3
# (default: deepseek/deepseek-v4-flash,tencent/hy4-flash,openai/gpt-6-luna)
ONECLIP_OPENROUTER_MODELS=

# Scene vision (the "vision" setting / --vision). A local OpenAI-compatible server with a
# vision model, e.g. LM Studio (default http://localhost:1234/v1); empty model: the first one it has
ONECLIP_VISION_URL=
ONECLIP_VISION_MODEL=
# OpenRouter vision models when vision is "openrouter" (paid), up to 3
# (default: qwen/qwen3.7-flash,google/gemma-3-12b-it,openai/gpt-5-nano)
ONECLIP_VISION_OPENROUTER_MODELS=

# Paths to editing agents if they aren't on PATH
CLAUDE_BIN=
OPENCODE_BIN=

# Paths to FFmpeg/FFprobe if they aren't on PATH
FFMPEG_BIN=
FFPROBE_BIN=

# Path to yt-dlp if it isn't on PATH (otherwise OneClip uses `python -m yt_dlp` and installs it with pip on first use)
YTDLP_BIN=
