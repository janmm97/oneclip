{
  "name": "oneclip",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source local AI video clipper: One CLI + TypeSafe Jev find the hooks, an agent plans the edit, FFmpeg + Remotion render vertical shorts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"pnpm --filter @oneclip/web dev\" \"pnpm worker\"",
    "start": "concurrently -k -n web,worker -c cyan,magenta \"pnpm --filter @oneclip/web start\" \"pnpm worker\"",
    "worker": "tsx workers/media/index.ts",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "clip": "tsx scripts/cli.ts",
    "eval:hooks": "tsx scripts/eval-hooks.ts",
    "sample": "tsx scripts/make-sample.ts",
    "e2e": "tsx scripts/e2e.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@oneclip/core": "workspace:*",
    "@oneclip/remotion": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  }
}
